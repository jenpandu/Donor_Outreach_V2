{
  "info": {
    "name": "Donor Outreach v2 - Demo",
    "description": "Flask -> AgentCore Runtime (LangGraph triage agent) -> staff review -> AgentCore Memory. Run folder 1 top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "campaign_id",
      "value": ""
    },
    {
      "key": "approve_id",
      "value": ""
    },
    {
      "key": "reject_id",
      "value": ""
    },
    {
      "key": "reply_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Demo (run top to bottom)",
      "description": "Happy path. IDs are saved to collection variables automatically, so just click Send on each request in order. The two inbound requests call AgentCore and take ~10-15 s each.",
      "item": [
        {
          "name": "0. Pre-flight: API + DB ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ready",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ready"
              ]
            },
            "description": "Run before the demo starts."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"API is up and DB reachable\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "1. Create campaign",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/campaigns",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "campaigns"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Spring Drive Demo\",\n  \"goal_amt\": 5000,\n  \"description\": \"Live demo: AgentCore triage + memory\",\n  \"def_lang\": \"en\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/campaigns",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "campaigns"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Spring Drive Demo\",\n  \"goal_amt\": 5000,\n  \"description\": \"Live demo: AgentCore triage + memory\",\n  \"def_lang\": \"en\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "CREATED",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": 37,\n  \"name\": \"Spring Drive Demo\",\n  \"goal_amt\": 5000.0,\n  \"description\": \"Live demo: AgentCore triage + memory\",\n  \"def_lang\": \"en\",\n  \"created_at\": \"2026-11-20T14:02:11.482913Z\"\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Campaign created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"campaign_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Inbound: Spanish receipt question (AgentCore)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/campaigns/{{campaign_id}}/messages/inbound",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "campaigns",
                "{{campaign_id}}",
                "messages",
                "inbound"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"donor_name\": \"Carlos Mendez\",\n  \"original_text\": \"¿Me pueden enviar mi recibo por correo electrónico, por favor?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Flask calls the LangGraph agent on AgentCore Runtime: detect language -> translate -> classify -> Knowledge Base -> draft reply in Spanish."
          },
          "response": [
            {
              "name": "201 Agent drafted",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
