            "body": {
              "mode": "raw",
              "raw": "{\n  \"donor_name\": \"Jane Doe\",\n  \"original_text\": \"Thank you so much for everything!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "'thanks' intent: the agent skips the Knowledge Base lookup. We'll reject this draft to show it never reaches Memory."
