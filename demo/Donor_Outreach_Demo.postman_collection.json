              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": 101,\n  \"campaign_id\": 37,\n  \"direction\": \"inbound\",\n  \"donor_name\": \"Carlos Mendez\",\n  \"original_text\": \"¿Me pueden enviar mi recibo por correo electrónico, por favor?\",\n  \"original_language\": \"es\",\n  \"translated_text\": \"Can you send me my receipt by email, please?\",\n  \"target_language\": \"en\",\n  \"intent\": null,\n  \"sentiment\": null,\n  \"draft_reply\": null,\n  \"status\": \"pending_review\",\n  \"created_at\": \"2026-11-20T14:02:38.901245Z\"\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const m = pm.response.json();",
                  "pm.test(\"Message saved\", () => pm.response.to.have.status(201));",
                  "pm.test(\"AgentCore classified it (intent: \" + m.intent + \")\", () => pm.expect(m.intent).to.not.be.null);",
                  "pm.test(\"AgentCore drafted a reply\", () => pm.expect(m.draft_reply).to.be.a(\"string\"));",
                  "pm.test(\"Waiting for staff review\", () => pm.expect(m.status).to.eql(\"pending_review\"));",
                  "pm.collectionVariables.set(\"approve_id\", m.id);"
                ]
              }
            }
          ]
        },
        {
