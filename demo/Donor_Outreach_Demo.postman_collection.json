                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"donor_name\": \"Carlos Mendez\",\n  \"original_text\": \"¿Me pueden enviar mi recibo por correo electrónico, por favor?\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Flask calls the LangGraph agent on AgentCore Runtime: detect language -> translate -> classify -> Knowledge Base -> draft reply in Spanish."
              },
              "status": "CREATED",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": 101,\n  \"campaign_id\": 37,\n  \"direction\": \"inbound\",\n  \"donor_name\": \"Carlos Mendez\",\n  \"original_text\": \"¿Me pueden enviar mi recibo por correo electrónico, por favor?\",\n  \"original_language\": \"es\",\n  \"translated_text\": \"Can you send me my receipt by email, please?\",\n  \"target_language\": \"en\",\n  \"intent\": \"question\",\n  \"sentiment\": \"neutral\",\n  \"draft_reply\": \"Estimado Carlos Mendez,\\n\\nGracias por su mensaje. Un miembro de nuestro equipo revisará su solicitud de recibo y se comunicará con usted por correo electrónico a la mayor brevedad.\\n\\nLanternwood Reading Alliance\",\n  \"status\": \"pending_review\",\n  \"created_at\": \"2026-11-20T14:02:38.901245Z\"\n}"
            },
            {
              "name": "201 Agent unavailable (v1 fallback)",
              "originalRequest": {
