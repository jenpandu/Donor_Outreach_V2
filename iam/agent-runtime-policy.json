{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "LanguageServices",
            "Effect": "Allow",
            "Action": [
                "comprehend:DetectDominantLanguage",
                "comprehend:DetectSentiment",
                "translate:TranslateText"
            ],
            "Resource": "*"
        },
        {
            "Sid": "KnowledgeBaseRetrieve",
            "Effect": "Allow",
            "Action": "bedrock:Retrieve",
            "Resource": "arn:aws:bedrock:us-east-1:397345411365:knowledge-base/3ZKP0J1OEI"
        },
        {
            "Sid": "AgentCoreMemoryRead",
            "Effect": "Allow",
            "Action": "bedrock-agentcore:RetrieveMemoryRecords",
            "Resource": "arn:aws:bedrock-agentcore:us-east-1:397345411365:memory/DonorOutreachMemory-0fyGfL7wJG"
        }
    ]
}
